# Prisma Config #
# Connect to Supabase via connection pooling.
DATABASE_URL="postgresql://postgres.<SUPABASE_PROJECT_REF>:[YOUR-PASSWORD]@<SUPABASE_POOLER_HOST>:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgresql://postgres.<SUPABASE_PROJECT_REF>:[YOUR-PASSWORD]@<SUPABASE_POOLER_HOST>:5432/postgres"

# Next Auth Config #
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BASE_PATH=http://localhost:3000/
NEXTAUTH_URL=http://localhost:3000/
NEXTAUTH_SECRET=

# Storage Configuration (AWS S3 or DigitalOcean Spaces)
STORAGE_TYPE=digitalocean

STORAGE_ACCESS_KEY_ID=your_accent_key_id
STORAGE_SECRET_ACCESS_KEY=your_access_key
STORAGE_REGION=ams3
STORAGE_BUCKET=your_bucket_name
STORAGE_ENDPOINT=your_endpoint
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CDN_URL=your_cdn_url

# SMTP Credentials
SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port
SMTP_SECURE=false
SMTP_USER=<SMTP_USER>
SMTP_PASS=your_smtp_pass

# Additional Optional Settings
SMTP_SENDER=Metronic
SMTP_FROM=<SMTP_FROM>

# Base URL
BASE_URL = /

# Microservice URLs (dev ports — production routes via in-cluster DNS or *.api.sebaoffice.ir)
CAPTCHA_API_BASE_URL=http://localhost:8000
AUTH_API_BASE_URL=http://localhost:8010
COMMON_API_BASE_URL=http://localhost:8020
FILE_ORCHESTRATOR_API_BASE_URL=http://localhost:8030
PERSON_API_BASE_URL=http://localhost:8040
COMPANY_API_BASE_URL=http://localhost:8050
MARKET_DATA_API_BASE_URL=http://localhost:8100
MARKET_HISTORY_API_BASE_URL=http://localhost:8110
PORTFOLIO_API_BASE_URL=http://localhost:8120
ERP_MEMBERS_API_BASE_URL=http://localhost:8200
CREDIT_RATING_API_BASE_URL=http://localhost:8300
CREDIT_RATING_CALCULATION_API_BASE_URL=http://localhost:8310
REPORT_API_BASE_URL=http://localhost:7100
FILE_STORAGE_API_BASE_URL=http://localhost:9000
PROJECT_API_BASE_URL=http://localhost:8080
CASHADVANCE_API_BASE_URL=http://localhost:8400
MPF_REPORT_API_BASE_URL=http://localhost:7110
